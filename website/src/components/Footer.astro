---
import { href, num, type Lang } from '../data/types';
import { t } from '../data/i18n';
import { COMPANY, CONTACT, OFFICES, ESTABLISHED, STATS } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const m = lang === 'mr';
const year = new Date().getFullYear();
const factory = OFFICES.find((o) => o.id === 'factory')!;
const colA = [
  ['/', d.home],
  ['/about/', d.about],
  ['/products/', d.products],
  ['/crops/', d.crops],
  ['/research-lab/', d.lab],
  ['/knowledge/', d.knowledge],
];
const colB = [
  ['/dealers/', d.dealersShort],
  ['/manufacturing/', d.manufacturing],
  ['/gallery/', d.gallery],
  ['/downloads/', d.downloads],
  ['/about/founder-message/', d.founder],
  ['/contact/', d.contact],
];
const social = [
  { name: d.whatsapp, url: `https://wa.me/${CONTACT.phonePrimary.wa}` },
  { name: 'Facebook', url: CONTACT.facebook },
  { name: 'YouTube', url: CONTACT.youtube },
  { name: d.email, url: `mailto:${CONTACT.email}` },
  { name: d.callUs, url: `tel:${CONTACT.phonePrimary.tel}` },
];
const brand = m ? 'लोकमंगल' : 'Lokmangal';
---

<footer class="ftr">
  <div class="container--wide ftr__top">
    <div class="ftr__brandwrap">
      <p class="ftr__brand" aria-hidden="true" data-reveal="blur">{brand}</p>
      <p class="ftr__tag" data-reveal="fade" style="--d:.15s">
        <span>{m ? 'बायोटेक' : 'Bio-Tech'}</span>
        <span>{m ? 'प्रा. लि.—' : 'Pvt. Ltd.—'}</span>
      </p>
    </div>
    <div class="ftr__time" data-reveal style="--d:.1s">
      <p class="ftr__based">
        <span class="ring" aria-hidden="true"></span>
        <span>{m ? `आम्ही सोलापूर, महाराष्ट्र येथे आहोत आणि ${num(lang, STATS.dealerStates)} राज्यांतील शेतकऱ्यांपर्यंत पोहोचतो.` : `We are based in Solapur, Maharashtra, and reach farmers in ${STATS.dealerStates} states.`}</span>
      </p>
      <p class="clock ftr__clock" data-clock>--:--:--</p>
      <p class="ftr__tz"><Icon name="globe" size={15} /> {m ? 'भारतीय प्रमाणवेळ (GMT+5:30)' : 'India Standard Time (GMT+5:30)'}</p>
    </div>
  </div>

  <div class="container--wide ftr__grid">
    <nav class="ftr__cell ftr__nav" aria-label={d.quickLinks}>
      <ul>{colA.map(([to, label]) => <li><a href={href(lang, to)}>{label}</a></li>)}</ul>
      <ul>{colB.map(([to, label]) => <li><a href={href(lang, to)}>{label}</a></li>)}</ul>
    </nav>
    <div class="ftr__cell ftr__ask">
      <h2>{m ? 'आमच्या टीमला विचारा' : 'Ask our team'}</h2>
      <p>{m ? 'तुमचे पीक आणि प्रश्न लिहा. संदेश व्हॉट्सॲपमध्ये पाठवण्यासाठी तयार होईल.' : 'Write your crop and your question. The message opens in WhatsApp, ready to send.'}</p>
      <form class="ftr__form" action={`https://wa.me/${CONTACT.phonePrimary.wa}`} method="get" target="_blank">
        <label class="sr-only" for="ftr-q">{m ? 'तुमचा प्रश्न' : 'Your question'}</label>
        <input id="ftr-q" name="text" type="text" required autocomplete="off" placeholder={m ? 'उदा. ऊसासाठी कोणते खत?' : 'e.g. Which fertilizer for sugarcane?'} />
        <button type="submit" aria-label={d.sendWhatsapp}><Icon name="arrow" size={20} /></button>
      </form>
      <small class="ftr__note">{d.formNote}</small>
    </div>
    <ul class="ftr__cell ftr__social">
      {
        social.map((s) => (
          <li>
            <a href={s.url} target={s.url.startsWith('http') ? '_blank' : undefined} rel={s.url.startsWith('http') ? 'noopener' : undefined}>
              {s.name} <Icon name="next" size={18} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container--wide ftr__bottom">
    <div>
      <small>{factory.kind[lang]}</small>
      <address>{factory.lines[lang]}</address>
      <a class="ftr__phone" href={`tel:${CONTACT.phonePrimary.tel}`}>{CONTACT.phonePrimary.label}</a>
    </div>
    <p>
      {m
        ? `${COMPANY.name.mr} ही ${num(lang, ESTABLISHED)} मध्ये स्थापन झालेली, ${COMPANY.group.mr}ाची कृषी-आधारित जैवतंत्रज्ञान कंपनी आहे. ${COMPANY.motto.mr}.`
        : `${COMPANY.name.en} is an agro-based biotechnology company of the ${COMPANY.group.en}, established in ${ESTABLISHED}. ${COMPANY.motto.en}.`}
    </p>
    <div class="ftr__legal">
      <span>© {num(lang, year)} {COMPANY.short[lang]}. {d.rights}</span>
      <a href={href(lang, '/credits/')}>{d.credits}</a>
      <a href={href(lang, '/contact/')}>{d.contact}</a>
    </div>
  </div>
</footer>
